{
  "name": "kaukau",
  "private": false,
  "version": "6.0.0-alpha.2",
  "description": "JS test tools, Mocha wrapper",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "import": "./lib/config.js",
      "require": "./lib/config.cjs",
      "default": "./lib/config.js"
    },
    "./kaukau": {
      "types": "./lib/kaukau.d.ts",
      "import": "./lib/kaukau.js",
      "require": "./lib/kaukau.cjs",
      "default": "./lib/kaukau.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kisiwu/kaukau.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown src/**/*.ts --format cjs,esm --out-dir lib --clean --dts --sourcemap --unbundle --no-fixed-extension",
    "check": "tsc --noEmit",
    "testcmd": "node ./lib/bin/kaukau",
    "cmd": "node ./lib/bin/kaukau --file test/tests --parameters test/config/parameters --config test/config/main.json",
    "cmd:isolate": "node ./lib/bin/kaukau --file test/tests --parameters test/config/parameters --config test/config/main.json --isolate",
    "cmd:esm": "node ./lib/bin/kaukau --parameters test/config/parameters-esm --config test/config/main-esm.json",
    "cmd:esm1": "node ./lib/bin/kaukau --config test/config/main-esm.mjs",
    "init": "node ./lib/bin/kaukau init --file test/tests/o2 --config test/config/main.json",
    "test": "node ./test/test.cjs",
    "test:esm": "node ./test/test-esm.cjs",
    "test:esm1": "node ./test/test-esm.mjs",
    "watch": "node ./lib/bin/kaukau --file test/tests --parameters test/config/parameters --config test/config/main.json --watch test/config/main.json --logs",
    "watch:esm": "node ./lib/bin/kaukau --file test/tests --parameters test/config/parameters-esm --config test/config/main-esm.json --watch test/config/main-esm.json --logs",
    "watch:isolate": "node ./lib/bin/kaukau --file test/tests --parameters test/config/parameters --config test/config/main.json --watch test/config/main.json --logs --isolate"
  },
  "bin": {
    "kaukau": "./lib/bin/kaukau.js"
  },
  "keywords": [
    "kaukau",
    "mocha",
    "test"
  ],
  "author": "demingongo (https://github.com/demingongo)",
  "license": "MIT",
  "dependencies": {
    "@novice1/logger": "^2.0.1-alpha.2",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "deep-property-access": "^1.0.1",
    "mkdirp": "^3.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/web": "^0.0.359",
    "chai": "^4.5.0",
    "mocha": "^12.0.3",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": ">=20",
    "mocha": "^12.0.3"
  },
  "peerDependenciesMeta": {
    "@types/mocha": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    }
  }
}
